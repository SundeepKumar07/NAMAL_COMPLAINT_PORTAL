# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-domain.com

# ─── MySQL ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ncmms_prod
DB_USER=ncmms
DB_PASSWORD=StrongPassword@Here

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex
JWT_EXPIRES_IN=24h

# ─── Seed admin (used on first db:seed run only) ──────────────────────────────
SEED_ADMIN_EMAIL=admin@namal.edu.pk
SEED_ADMIN_PASSWORD=ChangeThisImmediately!
SEED_ADMIN_NAME=System Administrator

# ─── Cloudinary (image uploads) ───────────────────────────────────────────────
# Leave blank to use local /uploads folder fallback (development only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
